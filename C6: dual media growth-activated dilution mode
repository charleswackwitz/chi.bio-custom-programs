    elif program == "C6":
        try:
            with open(f'InputParameters_{M}.csv', 'r') as f:
                reader = csv.reader(f)
                header = next(reader)
                values = next(reader)
            params = dict(zip(header, values))
    
            # Parameters
            ratio = float(params['media_ratio_start'])
            step = float(params['ratio_step'])
            output_multiplier = float(params['output_multiplier'])
            interval = int(params.get('dilution_interval', 1))
            volume = float(params.get('volume_ml', 20))
            min_od = float(params.get('min_od_threshold', 0.6))  # OD must exceed this to allow dilution
    
            # Persistent storage
            custom = sysData[M]['Custom']
            custom.setdefault('ratio_tracker', ratio)
            custom.setdefault('dilution_counter', 0)
            custom.setdefault('last_od', sysData[M]['OD']['current'])
            custom.setdefault('growth_rate_smooth', 0.0)
            custom.setdefault('diluting', False)
            custom.setdefault('start_time', sysData[M]['time']['record'][0] if sysData[M]['time']['record'] else 0)
            custom.setdefault('below_zero_count', 0)
    
            # Timing
            times = sysData[M]['time']['record']
            time_now = times[-1] if times else 0
            time_prev = times[-2] if len(times) > 1 else time_now
            delta_t = (time_now - time_prev) / 60.0 if time_now > time_prev else 1.0
            elapsed_min = (time_now - custom['start_time']) / 60.0
            allow_dilution = elapsed_min > 60 and sysData[M]['OD']['current'] > min_od
    
            # OD and growth
            OD = sysData[M]['OD']['current']
            OD_prev = custom['last_od']
            custom['last_od'] = OD
    
            if OD > 0 and OD_prev > 0 and delta_t > 0:
                raw_growth = math.log(OD / OD_prev) / delta_t
            else:
                raw_growth = 0.0
    
            smoothed = 0.95 * custom['growth_rate_smooth'] + 0.05 * raw_growth
            custom['growth_rate_smooth'] = smoothed
            sysData[M]['GrowthRate']['current'] = smoothed
    
            # Sustained low-growth tracker
            if smoothed < 0:
                custom['below_zero_count'] += 1
            else:
                custom['below_zero_count'] = 0
    
            # Trigger dilution if all conditions met
            if allow_dilution and custom['below_zero_count'] >= 3 and not custom['diluting']:
                custom['diluting'] = True
                custom['dilution_counter'] += 1
                if custom['dilution_counter'] % interval == 0:
                    custom['ratio_tracker'] = min(max(custom['ratio_tracker'] + step, 0.0), 1.0)
                    addTerminal(M, f"C6: Dilution started. Ratio updated to {custom['ratio_tracker']:.2f}")
                else:
                    addTerminal(M, "C6: Dilution started. No ratio change this interval.")
            elif smoothed >= 0 and custom['diluting']:
                custom['diluting'] = False
                addTerminal(M, f"C6: Growth recovered at {int(elapsed_min)} min. Exiting dilution.")
    
            # Only dilute if in dilution phase
            if custom['diluting']:
                percent_per_min = 4 * 60 / volume
                pump_rate = max(min(-smoothed / percent_per_min, 0.02), 0.0)
            else:
                pump_rate = 0.0
    
            r = custom['ratio_tracker']
            mediaA_rate = pump_rate * r
            mediaB_rate = pump_rate * (1 - r)
            waste_rate = pump_rate * output_multiplier
    
            sysData[M]['Pump1']['target'] = mediaA_rate * sysData[M]['Pump1']['direction']
            sysData[M]['Pump3']['target'] = mediaB_rate * sysData[M]['Pump3']['direction']
            sysData[M]['Pump2']['target'] = waste_rate * sysData[M]['Pump2']['direction']
    
            SetOutputOn(M, 'Pump1', 1)
            SetOutputOn(M, 'Pump3', 1)
            SetOutputOn(M, 'Pump2', 1)
    
            # Periodic flush every odd cycle
            if int(sysData[M]['Experiment']['cycles']) % 2 == 1:
                sysData[M]['Pump2']['target'] = 0.25 * sysData[M]['Pump2']['direction']
                SetOutputOn(M, 'Pump2', 1)
                addTerminal(M, f"C6: Flush pump triggered at cycle {sysData[M]['Experiment']['cycles']}")
    
            # Terminal output
            addTerminal(M, f"""C6 Summary:
      ➤ Elapsed = {int(elapsed_min)} min
      ➤ OD = {OD:.3f} (min threshold = {min_od})
      ➤ Smoothed Growth = {smoothed:.4f}/min
      ➤ Below-zero count = {custom['below_zero_count']}
      ➤ Diluting = {'YES' if custom['diluting'] else 'NO'}
      ➤ Media Ratio A:B = {r:.2f}:{1 - r:.2f}
      ➤ Pump1 (A) = {mediaA_rate:.4f}
      ➤ Pump3 (B) = {mediaB_rate:.4f}
      ➤ Pump2 (waste) = {waste_rate:.4f}""")
    
        except Exception as e:
            addTerminal(M, f"⚠️ Error in C6: {e}")
